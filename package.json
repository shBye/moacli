{
  "name": "moacli",
  "productName": "MoaCLI",
  "version": "0.1.20",
  "private": true,
  "description": "A desktop workspace that brings CLI coding agents, accounts, sessions, and conversations together",
  "author": "shBye",
  "homepage": "https://github.com/shBye/moacli",
  "repository": {
    "type": "git",
    "url": "https://github.com/shBye/moacli.git"
  },
  "main": "./dist/main/main.js",
  "scripts": {
    "postinstall": "node scripts/patch-xterm-ime.cjs && electron-rebuild -f --only better-sqlite3",
    "rebuild:native": "electron-rebuild -f --only better-sqlite3",
    "dev": "electron-vite dev",
    "start": "electron .",
    "start:lean": "node_modules\\electron\\dist\\electron.exe .",
    "start:low-memory": "node_modules\\electron\\dist\\electron.exe --disable-gpu .",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit",
    "package": "npm run build && electron-builder --publish never"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "5.5.0",
    "better-sqlite3": "^12.11.1",
    "lucide-react": "^0.468.0",
    "motion": "13.1.1",
    "node-pty": "1.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "10.1.0",
    "remark-breaks": "4.0.0",
    "remark-gfm": "4.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "33.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.0"
  }
}
